# Identificação exibida nos logs
APP_NAME=NexoZap

# No servidor Linux, mantenha as credenciais fora do código.
SESSION_DIR=/var/lib/nexozap/session

# trace, debug, info, warn, error ou fatal
LOG_LEVEL=info
# Use false com systemd para produzir logs JSON no journal.
LOG_PRETTY=false

# Tempo para login/conexão antes de um comando de envio falhar
CONNECT_TIMEOUT_MS=120000

# Intervalos da reconexão automática exponencial
RECONNECT_INITIAL_DELAY_MS=2000
RECONNECT_MAX_DELAY_MS=30000

# Limite preventivo de arquivo: 50 MiB
MAX_FILE_SIZE_MB=50

# API para Zabbix no mesmo servidor (somente localhost)
API_PORT=3000
API_TOKEN=
ALERT_GROUP_ID=

# Opcional: imagens dos gráficos (usuário local com leitura no frontend).
ZABBIX_GRAPHS_ENABLED=false
ZABBIX_URL=https://zabbix.example.com/
ZABBIX_USERNAME=nexozap-graficos
ZABBIX_PASSWORD=
