[Unit]
Description=NexoZap API Zabbix
After=network-online.target
Wants=network-online.target

[Service]
User=nexozap
Group=nexozap
WorkingDirectory=/opt/nexozap
ExecStart=/usr/bin/node /opt/nexozap/src/server.js
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nexozap
UMask=0077

[Install]
WantedBy=multi-user.target
